#include <WiFi.h>
#include <ThingSpeak.h>
#include <DHT.h>

// Wi-Fi credentials
const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

// ThingSpeak details
unsigned long channelID = YOUR_CHANNEL_ID;
const char* writeAPIKey = "YOUR_WRITE_API_KEY";

// Sensor pins
#define MQ135_PIN 34
#define DHT_PIN 4
#define DHT_TYPE DHT11

DHT dht(DHT_PIN, DHT_TYPE);
WiFiClient client;

unsigned long lastUpdate = 0;
const unsigned long updateInterval = 20000;

void setup() {
  Serial.begin(115200);

  dht.begin();

  // Connect to Wi-Fi
  WiFi.begin(ssid, password);

  Serial.print("Connecting to Wi-Fi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWi-Fi Connected!");

  // Initialize ThingSpeak
  ThingSpeak.begin(client);
}

void loop() {
  if (millis() - lastUpdate >= updateInterval) {
    lastUpdate = millis();

    // Read MQ-135 sensor
    int airQualityRaw = analogRead(MQ135_PIN);

    // Read temperature and humidity
    float temperature = dht.readTemperature();
    float humidity = dht.readHumidity();

    // Display readings
    Serial.println("---------------------------");
    Serial.print("MQ-135 Raw Reading: ");
    Serial.println(airQualityRaw);

    if (isnan(temperature) || isnan(humidity)) {
      Serial.println("DHT11 sensor reading failed!");
      return;
    }

    Serial.print("Temperature: ");
    Serial.print(temperature);
    Serial.println(" °C");

    Serial.print("Humidity: ");
    Serial.print(humidity);
    Serial.println(" %");

    // Upload data to ThingSpeak
    if (WiFi.status() == WL_CONNECTED) {
      ThingSpeak.setField(1, airQualityRaw);
      ThingSpeak.setField(2, temperature);
      ThingSpeak.setField(3, humidity);

      int response = ThingSpeak.writeFields(
        channelID, writeAPIKey
      );

      if (response == 200) {
        Serial.println("Data uploaded successfully!");
      } else {
        Serial.print("Upload failed. Error: ");
        Serial.println(response);
      }
    } else {
      Serial.println("Wi-Fi disconnected!");
    }
  }
}
